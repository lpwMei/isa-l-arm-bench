-1:	cbz	x2, 2f
-	ldrb	w6, [x1], #1
-	strb	w6, [x5], #1
-	sub	x2, x2, 1
-	b	1b
-2:
-	/* Load assembled bytes from stack */
-	ldr	q28, [sp]
-	add	sp, sp, 16
-	mov	x2, 0			/* all bytes consumed */
+	b	.crc_short_finish
 
 	/* ---- Process loaded 16B chunk ---- */
 .crc_short_process:
@@ -137,7 +119,9 @@
 
 	umov	x0, v2.d[0]
 	ubfx	x0, x0, 16, 16
-	ret
+	/* x1 points to the remaining 0..15 bytes, x2 is their exact length.
