diff --git a/src/crc16_xmodem_short.S b/src/crc16_xmodem_short.S
--- a/src/crc16_xmodem_short.S
+++ b/src/crc16_xmodem_short.S
@@ -48,27 +48,9 @@
 	sub	x2, x2, 16
 	b	.crc_short_process
 
-	/* ---- Partial tail: < 16 bytes, zero-padded load ---- */
+	/* Finish full chunks; consume the exact tail after reduction. */
 .crc_short_tail:
-	cbz	x2, .crc_short_finish
-
-	/* Zero a 16B buffer on the stack */
-	sub	sp, sp, 16
-	movi	v28.16b, 0
-	str	q28, [sp]
-
-	/* Copy remaining bytes to stack buffer */
